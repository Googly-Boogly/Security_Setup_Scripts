# Example environment for agent projects. PLACEHOLDERS ONLY.
#
# Copy to .env (git-ignored), fill in real values, then: chmod 600 .env
# Better: keep secrets in a password manager and inject them at run time,
# e.g.  ANTHROPIC_API_KEY="$(pass show api/anthropic)" \
#         ./setup/agents/agent_runner.sh --env ANTHROPIC_API_KEY ...
#
# Pass an agent only the variables it needs (--env NAME), never the whole file
# unless every entry is meant for that agent.

ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/app_db
